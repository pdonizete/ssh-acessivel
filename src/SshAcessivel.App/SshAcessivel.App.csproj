<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SshAcessivel.App</RootNamespace>
    <!-- Nome do executável: ssh-acessivel.exe -->
    <AssemblyName>ssh-acessivel</AssemblyName>
    <!-- Só gera recursos de idioma em pt-BR, sem pastas de satélite de outros idiomas. -->
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SshAcessivel.Core\SshAcessivel.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- O idioma do Strings.resx principal é pt-BR. -->
    <NeutralLanguage>pt-BR</NeutralLanguage>
  </PropertyGroup>

  <!--
    Gera a classe Strings (Strings.TestForm_Title etc.) a partir do .resx durante o build.
    Sem Visual Studio, é o próprio MSBuild que cria esse arquivo, dentro de obj/.
  -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>SshAcessivel.App.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    Copia a DLL do NVDA de lib/ para a pasta de saída (build) e de publicação (publish).
    O Condition evita erro de build se a DLL não existir: o app roda sem fala.
  -->
  <PropertyGroup>
    <NvdaDllPath>$(MSBuildThisFileDirectory)..\..\lib\nvdaControllerClient64.dll</NvdaDllPath>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(NvdaDllPath)')">
    <None Include="$(NvdaDllPath)"
          Link="nvdaControllerClient64.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
