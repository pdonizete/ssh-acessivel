<?xml version="1.0" encoding="utf-8"?>
<!--
  Fonte de pacotes do projeto. O NuGet.Config global desta máquina não tem
  nenhuma fonte, então definimos o nuget.org aqui. Vale só para esta pasta.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
